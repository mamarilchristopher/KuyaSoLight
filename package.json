{
  "name": "kuya-solight-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kuya SoLight Content Studio — production pipeline and CMS for SoLight Solar PH educational reels",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "NODE_NO_WARNINGS=1 tsx server/index.ts",
    "seed": "NODE_NO_WARNINGS=1 tsx server/seed.ts",
    "characters": "NODE_NO_WARNINGS=1 tsx pipeline/characters/sheets.ts",
    "render:e002": "NODE_NO_WARNINGS=1 tsx pipeline/render/cli.ts E002",
    "render:ep": "NODE_NO_WARNINGS=1 tsx pipeline/render/cli.ts",
    "render:identity": "NODE_NO_WARNINGS=1 tsx pipeline/render/cli.ts IDENTITY",
    "sonic": "python3 pipeline/audio/sonic.py",
    "test": "NODE_NO_WARNINGS=1 tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
