 "cues": [
  {
   "id": "c01",
   "text": "6 kWp na solar, 6 kW na inverter. Pareho ba 'yan?",
   "start": 0.25,
   "end": 5.73
  },
  {
   "id": "c02",
   "text": "Hello, SoSmart viewers! Kuya SoLight 'to!",
   "start": 6.08,
   "end": 8.95
  },
  {
   "id": "c03",
   "text": "Hindi. Ang kWp ay DC rating ng panels sa test conditions.",
   "start": 9.3,
   "end": 14.63
  },
  {
   "id": "c04",
   "text": "Ang kW ng inverter ay AC output na kaya nitong ilabas.",
   "start": 14.73,
   "end": 20.35
  },
  {
   "id": "c05",
   "text": "Puwedeng mas malaki ang panels kaysa inverter.",
   "start": 20.65,
   "end": 23.24
  },
  {
   "id": "c06",
   "text": "Tinatawag itong DC-to-AC ratio.",
   "start": 23.29,
   "end": 25.84
  },
  {
   "id": "c07",
   "text": "Kapag sobra ang DC sa tanghali, may clipping.",
   "start": 26.14,
   "end": 29.49
  },
  {
   "id": "c08",
   "text": "Normal 'yan, basta tama ang design at kalkula.",
   "start": 29.79,
   "end": 32.88
  },
  {
   "id": "cz1",
   "text": "Dahil ang gusto ni Kuya SoLight… naka-solar ka na, SoSmart ka pa!",
   "start": 33.28,
   "end": 37.87
  },
  {
   "id": "cz2",
   "text": "Life is SoLight with Solar.",
   "start": 38.22,
   "end": 40.4
  }
