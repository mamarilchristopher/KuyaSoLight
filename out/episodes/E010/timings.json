  {
   "id": "c01",
   "text": "Bakit hindi umaabot sa rated watts ang panels mo?",
   "start": 0.25,
   "end": 2.82
  },
  {
   "id": "c02",
   "text": "Hello, SoSmart viewers! Kuya SoLight 'to!",
   "start": 3.17,
   "end": 5.94
  },
  {
   "id": "c03",
   "text": "Ang rating ay galing sa lab test: standard test conditions.",
   "start": 6.29,
   "end": 10.5
  },
  {
   "id": "c04",
   "text": "1000 W/m² na liwanag at 25°C na cell temperature.",
   "start": 10.6,
   "end": 16.93
  },
  {
   "id": "c05",
   "text": "Sa totoong bubong, mas mainit ang panels,",
   "start": 17.23,
   "end": 20.41
  },
  {
