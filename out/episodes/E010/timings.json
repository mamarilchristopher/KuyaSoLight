 "cues": [
  {
   "id": "c01",
   "text": "Bakit hindi umaabot sa rated watts ang panels mo?",
   "start": 0.25,
   "end": 3.491
  },
  {
   "id": "c02",
   "text": "Hello, SoSmart viewers! Kuya SoLight 'to!",
   "start": 3.841,
   "end": 6.611
  },
  {
   "id": "c03",
   "text": "Ang rating ay galing sa lab test: standard test conditions.",
   "start": 6.961,
   "end": 11.171
  },
  {
   "id": "c04",
   "text": "1000 W/m² na liwanag at 25°C na cell temperature.",
   "start": 11.271,
   "end": 17.601
  },
  {
   "id": "c05",
   "text": "Sa totoong bubong, mas mainit ang panels,",
   "start": 17.901,
   "end": 21.081
  },
  {
   "id": "c06",
   "text": "at kapag mas mainit, bumababa ang output.",
   "start": 21.131,
   "end": 24.521
  },
  {
   "id": "c07",
   "text": "May epekto rin ang anino, alikabok, at anggulo ng araw.",
