 "cues": [
  {
   "id": "c01",
   "text": "Saan nga ba galing ang kuryente sa bahay mo?",
   "start": 0.25,
   "end": 2.61
  },
  {
   "id": "c02",
   "text": "Hello, SoSmart viewers! Kuya SoLight 'to!",
   "start": 2.96,
   "end": 5.83
  },
  {
   "id": "c03",
   "text": "Habang may araw, solar ang unang sumusuplay sa bahay.",
   "start": 6.18,
   "end": 9.77
  },
  {
   "id": "c04",
   "text": "Kapag sobra, puwedeng i-export sa grid kung naka-net metering.",
   "start": 10.07,
   "end": 14.84
  },
  {
   "id": "c05",
   "text": "Kung may battery, puwede rin itong mag-charge.",
   "start": 15.14,
   "end": 18.45
  },
  {
   "id": "c06",
   "text": "Sa gabi, battery o grid na ang nagsu-supply.",
   "start": 18.75,
   "end": 22.74
  },
  {
   "id": "c07",
   "text": "Kapag alam mo ang daloy, mas madaling magtipid.",
   "start": 23.04,
   "end": 26.43
  },
  {
   "id": "cz1",
   "text": "Dahil ang gusto ni Kuya SoLight… naka-solar ka na, SoSmart ka pa!",
   "start": 26.83,
   "end": 31.98
  },
  {
   "id": "cz2",
   "text": "Life is SoLight with Solar.",
   "start": 32.33,
   "end": 34.51
  }
