 "cues": [
  {
   "id": "c01",
   "text": "Hybrid-ready daw ang inverter mo. May backup ka na ba?",
   "start": 0.25,
   "end": 3.86
  },
  {
   "id": "c02",
   "text": "Hello, SoSmart viewers! Kuya SoLight 'to!",
   "start": 4.21,
   "end": 6.98
  },
  {
   "id": "c03",
   "text": "Hindi pa. Ibig sabihin lang, puwede itong lagyan ng battery.",
   "start": 7.33,
   "end": 11.6
  },
  {
   "id": "c04",
   "text": "Para gumana ang backup, kailangan ng compatible na battery,",
   "start": 11.9,
   "end": 15.61
  },
  {
   "id": "c05",
   "text": "tamang backup wiring o critical loads panel,",
   "start": 15.66,
   "end": 18.87
  },
  {
   "id": "c06",
   "text": "at inverter na naka-set up talaga para sa backup.",
   "start": 18.92,
   "end": 22.87
  },
  {
   "id": "c07",
   "text": "Kung kulang ang mga 'yan, puwedeng brownout ka pa rin.",
   "start": 23.17,
   "end": 26.96
  },
  {
   "id": "c08",
   "text": "Kaya bago bumili, ipa-verify ang buong backup setup.",
   "start": 27.26,
   "end": 30.93
  },
  {
   "id": "cz1",
   "text": "Dahil ang gusto ni Kuya SoLight… naka-solar ka na, SoSmart ka pa!",
   "start": 31.33,
   "end": 36.81
  },
  {
   "id": "cz2",
   "text": "Life is SoLight with Solar.",
   "start": 37.16,
   "end": 38.57
  }
