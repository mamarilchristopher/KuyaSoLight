 "cues": [
  {
   "id": "c01",
   "text": "May solar ka, pero may Meralco bill ka pa rin?",
   "start": 0.25,
   "end": 3.1
  },
  {
   "id": "c02",
   "text": "Hello, SoSmart viewers! Kuya SoLight 'to!",
   "start": 3.45,
   "end": 6.22
  },
  {
   "id": "c03",
   "text": "Sa typical self-consumption setup,",
   "start": 6.57,
   "end": 8.56
  },
  {
   "id": "c04",
   "text": "tumutulong ang solar sa daytime electricity use mo.",
   "start": 8.64,
   "end": 11.95
  },
  {
   "id": "c05",
   "text": "Pero kapag kulang ang solar generation,",
   "start": 12.25,
   "end": 14.4
  },
  {
   "id": "c06",
   "text": "o gabi na at wala kang battery,",
   "start": 14.48,
   "end": 16.37
  },
  {
   "id": "c07",
   "text": "puwede ka pa ring kumuha ng kuryente sa grid.",
   "start": 16.45,
   "end": 18.68
  },
  {
   "id": "c08",
   "text": "May mga bill charges din na hindi basta nawawala.",
   "start": 18.98,
   "end": 21.87
  },
  {
   "id": "c09",
   "text": "Kaya hindi dapat mangako ng automatic zero bill.",
   "start": 22.12,
   "end": 25.05
  },
  {
   "id": "c10",
   "text": "Dahil ang gusto ni Kuya SoLight… naka-solar ka na, SoSmart ka pa!",
   "start": 25.45,
   "end": 30.93
  },
  {
   "id": "c11",
   "text": "Life is SoLight with Solar.",
   "start": 31.28,
   "end": 32.69
  }
