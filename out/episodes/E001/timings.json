 "cues": [
  {
   "id": "c01",
   "text": "Ano ba talaga ang ginagawa ng solar panels mo?",
   "start": 0.25,
   "end": 2.67
  },
  {
   "id": "c02",
   "text": "Hello, SoSmart viewers! Kuya SoLight 'to!",
   "start": 3.02,
   "end": 5.89
  },
  {
   "id": "c03",
   "text": "Simple lang: liwanag ng araw ang tumatama sa panels.",
   "start": 6.24,
   "end": 10.75
  },
  {
   "id": "c04",
   "text": "Ginagawa itong DC na kuryente ng solar cells.",
   "start": 10.85,
   "end": 13.46
  },
  {
   "id": "c05",
   "text": "Pero AC ang gamit ng appliances sa bahay.",
   "start": 13.71,
   "end": 16.96
  },
  {
   "id": "c06",
   "text": "Kaya may inverter: ginagawa nitong AC ang DC.",
   "start": 17.06,
   "end": 21.47
  },
  {
   "id": "c07",
   "text": "Habang may araw, solar ang tumutulong sa bahay mo.",
   "start": 21.72,
   "end": 25.61
  },
  {
   "id": "c08",
   "text": "Kapag kulang o gabi na, grid o battery ang sasalo.",
   "start": 25.91,
   "end": 30.02
  },
  {
   "id": "c09",
   "text": "Panels, inverter, at tamang setup. 'Yan ang solar!",
   "start": 30.32,
   "end": 35.71
  },
  {
   "id": "cz1",
   "text": "Dahil ang gusto ni Kuya SoLight… naka-solar ka na, SoSmart ka pa!",
   "start": 36.11,
   "end": 41.38
  },
  {
   "id": "cz2",
   "text": "Life is SoLight with Solar.",
   "start": 41.73,
   "end": 43.89
  }
