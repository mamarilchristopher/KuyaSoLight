 "cues": [
  {
   "id": "c01",
   "text": "kW at kWh… pareho lang ba 'yan?",
   "start": 0.25,
   "end": 3.74
  },
  {
   "id": "c02",
   "text": "Hello, SoSmart viewers! Kuya SoLight 'to!",
   "start": 4.09,
   "end": 6.96
  },
  {
   "id": "c03",
   "text": "Ang kW ay power: gaano kabilis gumamit ng kuryente.",
   "start": 7.31,
   "end": 12.06
  },
  {
   "id": "c04",
   "text": "Ang kWh ay energy: gaano karami ang nagamit.",
   "start": 12.31,
   "end": 17.38
  },
  {
   "id": "c05",
   "text": "Halimbawa, isang 100-watt na TV.",
   "start": 17.68,
   "end": 21.41
  },
  {
   "id": "c06",
   "text": "Kapag binuksan mo nang 10 oras,",
   "start": 21.51,
   "end": 23.43
  },
  {
   "id": "c07",
   "text": "1 kWh ang nagamit nito.",
   "start": 23.48,
   "end": 25.67
  },
  {
   "id": "c08",
   "text": "Sa Meralco bill, kWh ang basehan ng energy charges.",
   "start": 25.97,
   "end": 31.18
  },
  {
   "id": "c09",
   "text": "Kaya bago mag-solar, kilalanin pareho: kW at kWh.",
   "start": 31.48,
   "end": 37.21
  },
  {
   "id": "cz1",
   "text": "Dahil ang gusto ni Kuya SoLight… naka-solar ka na, SoSmart ka pa!",
   "start": 37.61,
   "end": 43.1
  },
  {
   "id": "cz2",
   "text": "Life is SoLight with Solar.",
   "start": 43.45,
   "end": 45.63
  }
