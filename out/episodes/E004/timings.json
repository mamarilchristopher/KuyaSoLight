 "cues": [
  {
   "id": "c01",
   "text": "Grid-tied, hybrid, o off-grid: alin ang para sa'yo?",
   "start": 0.25,
   "end": 5.0
  },
  {
   "id": "c02",
   "text": "Hello, SoSmart viewers! Kuya SoLight 'to!",
   "start": 5.35,
   "end": 8.22
  },
  {
   "id": "c03",
   "text": "Grid-tied: solar at grid ang magkatuwang, walang battery.",
   "start": 8.57,
   "end": 13.34
  },
  {
   "id": "c04",
   "text": "Kapag brownout, kusa itong namamatay para sa safety.",
   "start": 13.64,
   "end": 17.61
  },
  {
   "id": "c05",
   "text": "Hybrid: may battery, pero depende sa setup ang backup.",
   "start": 17.91,
   "end": 22.22
  },
  {
   "id": "c06",
   "text": "Off-grid: walang grid, battery ang sandalan sa gabi.",
   "start": 22.52,
   "end": 27.25
  },
  {
   "id": "c07",
   "text": "Kaya hindi pare-pareho ang backup ng tatlo.",
   "start": 27.55,
   "end": 31.22
  },
  {
   "id": "c08",
   "text": "Itanong muna: anong loads ang kailangan sa brownout?",
   "start": 31.52,
   "end": 35.67
  },
  {
   "id": "cz1",
   "text": "Dahil ang gusto ni Kuya SoLight… naka-solar ka na, SoSmart ka pa!",
   "start": 36.07,
   "end": 41.56
  },
  {
   "id": "cz2",
   "text": "Life is SoLight with Solar.",
   "start": 41.91,
   "end": 44.03
  }
