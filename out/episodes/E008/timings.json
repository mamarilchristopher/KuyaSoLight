 "cues": [
  {
   "id": "c01",
   "text": "Gumagana ba ang solar panels sa gabi?",
   "start": 0.25,
   "end": 2.54
  },
  {
   "id": "c02",
   "text": "Hello, SoSmart viewers! Kuya SoLight 'to!",
   "start": 2.89,
   "end": 5.66
  },
  {
   "id": "c03",
   "text": "Hindi. Kailangan ng liwanag para gumawa ng kuryente.",
   "start": 6.01,
   "end": 10.43
  },
  {
   "id": "c04",
   "text": "Kung solar ang gamit mo sa gabi,",
   "start": 10.73,
   "end": 12.56
  },
  {
   "id": "c05",
   "text": "galing 'yan sa battery na nag-charge noong araw.",
   "start": 12.61,
   "end": 16.27
  },
  {
   "id": "c06",
   "text": "Kapag wala o ubos na ang battery, grid na ang kukunan.",
   "start": 16.57,
   "end": 20.96
  },
  {
   "id": "c07",
   "text": "Magkaiba ang solar generation at stored energy.",
   "start": 21.26,
   "end": 26.57
  },
  {
   "id": "cz1",
   "text": "Dahil ang gusto ni Kuya SoLight… naka-solar ka na, SoSmart ka pa!",
   "start": 26.97,
   "end": 32.18
  },
  {
   "id": "cz2",
   "text": "Life is SoLight with Solar.",
   "start": 32.53,
   "end": 34.99
  }
