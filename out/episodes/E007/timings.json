 "cues": [
  {
   "id": "c01",
   "text": "Umuulan. May silbi pa ba ang solar mo?",
   "start": 0.25,
   "end": 3.0
  },
  {
   "id": "c02",
   "text": "Hello, SoSmart viewers! Kuya SoLight 'to!",
   "start": 3.35,
   "end": 6.22
  },
  {
   "id": "c03",
   "text": "Oo, pero mas mahina ang output.",
   "start": 6.57,
   "end": 8.85
  },
  {
   "id": "c04",
   "text": "Kapag maulap, nababawasan ang liwanag sa panels.",
   "start": 9.1,
   "end": 12.75
  },
  {
   "id": "c05",
   "text": "Kaya bumababa ang output, minsan malaki ang bawas.",
   "start": 12.85,
   "end": 16.54
  },
  {
   "id": "c06",
   "text": "Pero madalas hindi zero, dahil may diffuse light pa rin.",
   "start": 16.84,
   "end": 20.31
  },
  {
   "id": "c07",
   "text": "Ang tamang tingin: kWh sa buong buwan, hindi isang araw.",
   "start": 20.61,
   "end": 26.16
  },
  {
   "id": "cz1",
   "text": "Dahil ang gusto ni Kuya SoLight… naka-solar ka na, SoSmart ka pa!",
   "start": 26.56,
   "end": 32.57
  },
  {
   "id": "cz2",
   "text": "Life is SoLight with Solar.",
   "start": 32.92,
   "end": 35.1
  }
